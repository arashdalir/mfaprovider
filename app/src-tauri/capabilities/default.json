{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the app's own IPC commands, no plugin or core permissions",
  "windows": ["main"],
  "permissions": [
    "allow-vault-status",
    "allow-list-otp-types",
    "allow-create-vault",
    "allow-unlock",
    "allow-lock",
    "allow-record-activity",
    "allow-set-idle-lock",
    "allow-list-entries",
    "allow-add-entry",
    "allow-edit-entry",
    "allow-delete-entry",
    "allow-move-entry",
    "allow-advance-counter",
    "allow-reveal-secret",
    "allow-change-password"
  ]
}
