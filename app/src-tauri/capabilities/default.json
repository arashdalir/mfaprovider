{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the app's own IPC commands, no plugin or core permissions",
  "windows": ["main"],
  "permissions": [
    "allow-vault-status",
    "allow-list-otp-types",
    "allow-create-vault",
    "allow-unlock",
    "allow-biometric-status",
    "allow-biometric-enable",
    "allow-biometric-disable",
    "allow-unlock-with-biometric",
    "allow-set-biometric-reprompt-days",
    "allow-lock",
    "allow-record-activity",
    "allow-report-backgrounded",
    "allow-set-idle-lock",
    "allow-list-entries",
    "allow-add-entry",
    "allow-edit-entry",
    "allow-delete-entry",
    "allow-move-entry",
    "allow-advance-counter",
    "allow-reveal-secret",
    "allow-change-password",
    "allow-draft-from-link",
    "allow-draft-from-image",
    "allow-add-draft",
    "allow-check-duplicate",
    "allow-check-draft-duplicate",
    "allow-discard-drafts",
    "allow-list-import-formats",
    "allow-import-preview",
    "allow-import-apply",
    "allow-import-discard"
  ]
}
